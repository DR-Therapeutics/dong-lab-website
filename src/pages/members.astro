---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (path: string) => `${base}${path}`;

// Update names, roles, or photo filenames here.
const sections = [
  {
    id: "leadership",
    title: "Lab leadership",
    members: [
      {
        name: "Xuesen Dong",
        role: "Principal Investigator",
        photo: "xuesen-dong.jpg",
      },
      {
        name: "Ning Xie",
        role: "Lab Manager",
        photo: "ning-xie.jpg",
      },
    ],
  },
  {
    id: "students",
    title: "PhD students",
    members: [
      {
        name: "Victor Matias-Barrios",
        role: "PhD Student",
        photo: "victor-matias-barrios.jpg",
      },
      {
        name: "Qiongqiong Jia",
        role: "PhD Student",
        photo: "qiongqiong-jia.jpg",
      },
      {
        name: "Zechao Huang",
        role: "PhD Student",
        photo: "zechao-huang.jpg",
      },
      {
        name: "Tianlong Luo",
        role: "PhD Student",
        photo: "tianlong-luo.jpg",
      },
      {
        name: "Degeng Kong",
        role: "PhD Student",
        photo: "degeng-kong.jpg",
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Our People | Dong Lab</title>
    <meta
      name="description"
      content="Meet the principal investigator, lab manager, and PhD students of Dong Lab."
    />

    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) {
        margin: 0;
        background: #f7f8f5;
        color: #152c3d;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.6;
      }
      :global(a) { color: inherit; }
      :global(a:focus-visible) {
        outline: 3px solid #087d79;
        outline-offset: 5px;
      }
      .container {
        width: min(1120px, calc(100% - 40px));
        margin-inline: auto;
      }
      .skip-link {
        position: absolute;
        top: -100px;
        left: 20px;
        padding: 12px;
        background: white;
        z-index: 10;
      }
      .skip-link:focus { top: 12px; }
      .site-header {
        background: #fff;
        border-bottom: 1px solid #dce3e5;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        min-height: 86px;
        padding-block: 18px;
      }
      .brand {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-decoration: none;
      }
      nav { display: flex; gap: 26px; }
      nav a {
        text-decoration: none;
        padding-block: 6px;
        border-bottom: 2px solid transparent;
      }
      nav a:hover,
      nav a[aria-current="page"] {
        color: #086d69;
        border-bottom-color: #086d69;
      }
      .intro { padding: 72px 0 48px; }
      .eyebrow {
        margin: 0 0 12px;
        color: #086d69;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      h1 {
        margin: 0;
        font-size: clamp(2.8rem, 7vw, 4.8rem);
        line-height: 1.08;
        letter-spacing: -0.05em;
      }
      .intro-text {
        margin-top: 20px;
        color: #53636e;
        font-size: 1.15rem;
      }
      .team-section { margin-bottom: 56px; }
      .section-title {
        margin: 0 0 24px;
        padding-bottom: 14px;
        border-bottom: 1px solid #ccd7db;
        font-size: 1.25rem;
      }
      .people-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 26px;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .person {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid #dce3e5;
        border-radius: 10px;
      }
      .portrait {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: contain;
        background: #e8edef;
      }
      .person-info { padding: 22px; }
      .person-name {
        margin: 0 0 6px;
        font-size: 1.2rem;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }
      .person-role {
        margin: 0;
        color: #086d69;
        font-size: 0.95rem;
      }
      .leadership {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .leadership .person {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: center;
      }
      footer {
        border-top: 1px solid #dce3e5;
        padding: 28px 0;
        color: #53636e;
        font-size: 0.9rem;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }
      @media (max-width: 850px) {
        .people-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .leadership { grid-template-columns: 1fr; }
      }
      @media (max-width: 500px) {
        .intro { padding-top: 48px; }
        .people-grid { grid-template-columns: 1fr; }
        .person-info { padding: 20px; }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>DONG LAB</a>
        <nav aria-label="Main navigation">
          <a href={base}>Home</a>
          <a href={url("members/")} aria-current="page">Members</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="container">
      <div class="intro">
        <p class="eyebrow">Meet the team</p>
        <h1>Our people.</h1>
        <p class="intro-text">
          Meet the people behind the research at Dong Lab.
        </p>
      </div>

      {sections.map((section) => (
        <section class="team-section" aria-labelledby={section.id}>
          <h2 id={section.id} class="section-title">
            {section.title}
          </h2>
          <ul class:list={[
            "people-grid",
            { leadership: section.id === "leadership" },
          ]}>
            {section.members.map((member) => (
              <li class="person">
                <img
                  class="portrait"
                  src={url(`images/members/${member.photo}`)}
                  alt={`Portrait of ${member.name}`}
                  width="640"
                  height="800"
                  loading={section.id === "leadership" ? "eager" : "lazy"}
                  decoding="async"
                />
                <div class="person-info">
                  <h3 class="person-name">{member.name}</h3>
                  <p class="person-role">{member.role}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>

    <footer>
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Dong Lab</span>
        <a href={base}>Back to homepage</a>
      </div>
    </footer>
  </body>
</html>
