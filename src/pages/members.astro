---
import home from '../content/home.json';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const asset = (path: string) => base + path.replace(/^\//, '');
const canonical = new URL(
  asset('members/'),
  Astro.site || Astro.url.origin
).href;

const pageTitle = `Our People | ${home.labName}`;
const description =
  'Meet the principal investigator, lab manager, and PhD students of Dong Lab.';

const banner = 'images/experimental-validation.png';
const bannerAlt = 'Conceptual illustration of cell culture.';

// Keep Xuesen Dong first: the first member has a row of their own.
// Everyone else appears in this order, five per row on desktop.
// To add someone, upload their photo to public/images/members/ and
// append another object to this array. Use a full https:// URL or ''.
const members = [
  {
    name: 'Xuesen Dong',
    role: 'Principal Investigator',
    photo: 'xuesen-dong.jpg',
    link: home.contact.profileUrl,
  },
  {
    name: 'Victor Matias-Barrios',
    role: 'PhD Student',
    photo: 'victor-matias-barrios.jpg',
    link: '',
  },
  {
    name: 'Qiongqiong Jia',
    role: 'PhD Student',
    photo: 'qiongqiong-jia.jpg',
    link: '',
  },
  {
    name: 'Zechao Huang',
    role: 'PhD Student',
    photo: 'zechao-huang.jpg',
    link: 'http://vinkey.com',
  },
  {
    name: 'Tianlong Luo',
    role: 'PhD Student',
    photo: 'tianlong-luo.jpg',
    link: '',
  },
  {
    name: 'Degeng Kong',
    role: 'PhD Student',
    photo: 'degeng-kong.jpg',
    link: '',
  },
  {
    name: 'Ning Xie',
    role: 'Lab Manager',
    photo: 'ning-xie.jpg',
    link: '',
  },
];
const groupPhotos = [
  {
    image: 'images/members/group-01.jpg',
    alt: 'Dong Lab group photo',
    caption: '',
  },
  {
    image: 'images/members/group-02.jpg',
    alt: 'Dong Lab team together',
    caption: '',
  },
  {
    image: 'images/members/group-03.jpg',
    alt: 'Lab gathering',
    caption: '',
  },
  {
    image: 'images/members/group-04.jpg',
    alt: 'Christmas 2025',
    caption: '',
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08253f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(
        asset(home.hero.image),
        Astro.site || Astro.url.origin
      ).href}
    />
    <meta property="og:image:alt" content={home.hero.imageAlt} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader currentPage="members" />
    
    <main id="main">
      <section
        class="hero members-hero"
        id="top"
        aria-labelledby="members-title"
      >
        <img
          class="hero-image"
          src={asset(home.hero.image)}
          alt={home.hero.imageAlt}
          width="1672"
          height="941"
          fetchpriority="high"
        />
        <div class="hero-shade" aria-hidden="true"></div>

        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">The Dong Lab team</p>
            <h1 id="members-title">
              Our people.
              <em>Shared curiosity.</em>
            </h1>
            <p class="hero-description">
              Meet the people behind the research at Dong Lab.
            </p>

            <div class="hero-actions">
              <a class="button button-light" href="#team">
                Meet the team <span aria-hidden="true">↓</span>
              </a>
              <a class="text-link" href={`${base}#research`}>
                Our research <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <p class="hero-caption">Conceptual research illustration</p>
        </div>
      </section>

      <div class="affiliation-strip">
        <div class="container affiliation-inner">
          <a href="https://www.prostatecentre.com/">
            Vancouver Prostate Centre
          </a>
          <span class="strip-divider" aria-hidden="true"></span>
          <a href="https://urology.med.ubc.ca/">
            UBC · Department of Urologic Sciences
          </a>
        </div>
      </div>

     <section
  class="section members-section about-section"
  id="team"
  aria-labelledby="team-title"
>
  <div class="container">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Our team</p>
        <h2 id="team-title">Meet our members.</h2>
      </div>
    </div>

    <ul class="members-grid">
      {members.map((person) => (
        <li class="member">
          {person.link ? (
  <a
    class="member-photo-link"
    href={person.link}
    aria-label={`View ${person.name}'s profile`}
  >
    <img
      class="member-photo"
      src={asset(`images/members/${person.photo}`)}
      alt={`Portrait of ${person.name}`}
      width="640"
      height="800"
      loading="lazy"
      decoding="async"
    />
  </a>
) : (
  <img
    class="member-photo"
    src={asset(`images/members/${person.photo}`)}
    alt={`Portrait of ${person.name}`}
    width="640"
    height="800"
    loading="lazy"
    decoding="async"
  />
)}

          <div class="member-copy">
            <h3 class="member-name">
              {person.link ? (
                <a class="member-link" href={person.link}>
                  {person.name}
                </a>
              ) : (
                person.name
              )}
            </h3>
            <p class="eyebrow member-role">{person.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<section
  class="section research-section group-section"
  id="group-photos"
  aria-labelledby="group-photos-title"
>
  <div class="container">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Life in the lab</p>
        <h2 id="group-photos-title">Group photos.</h2>
      </div>
      <p>Select a photo to view it at full size.</p>
    </div>

    <div class="group-gallery">
      {groupPhotos.map((photo) => (
        <figure class="group-photo">
          <a
            class="group-photo-link"
            href={asset(photo.image)}
            aria-label={`View full-size photo: ${photo.alt}`}
          >
            <img
              src={asset(photo.image)}
              alt={photo.alt}
              width="1500"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </a>

          {photo.caption && (
            <figcaption>{photo.caption}</figcaption>
          )}
        </figure>
      ))}
    </div>
  </div>
</section>

      <section class="contact-section publications-contact" aria-labelledby="publication-contact-title">
        <div class="container">
          <p class="eyebrow">CONNECT WITH US</p>
          <h2 id="publication-contact-title">Continue the conversation.</h2>
          <p>Interested in our work or a possible collaboration? We would like to hear from you.</p>
          <a class="button button-light" href={`${base}#contact`}>Contact the lab <span aria-hidden="true">↗</span></a>
        </div>
      </section>
</main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getUTCFullYear()} {home.labName}</p>
        <p>RNA biology. Cancer research. Therapeutic discovery.</p>
        <a href="#top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "aa79c36c6ed04e05b5b7e1e19f3b9453"}'
    ></script>
  </body>
</html>

<style>
  /* Banner */
  .members-hero {
    height: auto;
    min-height: 0;
  }

  .members-hero .hero-inner {
    min-height: 460px;
    padding-block: clamp(64px, 7vw, 96px);
  }

  .members-hero .hero-copy {
    max-width: 850px;
  }

  .members-section {
    scroll-margin-top: 110px;
  }

  .members-section .section-intro {
    margin-bottom: 40px;
  }

  /* Five equal columns, aligned to the left.
     Maximum width: 5 × 200px photos + 4 × 24px gaps. */
  .members-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 40px 24px;
    width: 100%;
    max-width: 1096px;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: start;
  }

  .members-grid > .member {
    min-width: 0;
    text-align: center;
  }

  /* Reserve the whole first row for Xuesen Dong, while keeping his
     card at the left and exactly as wide as one of the five columns.
     All remaining members flow automatically from the second row. */
  .members-grid > .member:first-child {
    grid-column: 1 / -1;
    width: calc((100% - 96px) / 5);
    justify-self: start;
  }

  .member-photo-link {
    display: block;
  }

  .member-photo {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    background: rgba(8, 37, 63, 0.045);
  }

  .member-copy {
    padding-top: 20px;
  }

  .member-name {
    margin: 0;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .member-role {
    margin: 12px 0 0;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .member-link:focus-visible,
  .member-photo-link:focus-visible,
  .group-photo-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 7px;
    text-decoration-thickness: 2px;
  }

  /* Group-photo gallery */
  .group-section .section-intro {
    margin-bottom: 36px;
  }

  .group-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .group-photo {
    min-width: 0;
    margin: 0;
  }

  .group-photo-link {
    display: block;
    background: rgba(8, 37, 63, 0.045);
  }

  .group-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  .group-photo figcaption {
    margin-top: 12px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Tablets: two portraits per row */
  @media (max-width: 900px) {
    .members-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 424px;
    }

    /* Keep the first card the same width as one tablet column. */
    .members-grid > .member:first-child {
      width: calc((100% - 24px) / 2);
    }
  }

  /* Phones */
  @media (max-width: 600px) {
    .site-header .header-inner {
      flex-wrap: wrap;
      gap: 18px;
    }

    .site-header nav {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .members-hero .hero-inner {
      min-height: 400px;
      padding-block: 64px;
    }

    .members-grid {
      grid-template-columns: 1fr;
      max-width: 200px;
    }

    .members-grid > .member:first-child {
      width: 100%;
    }

    .group-gallery {
      grid-template-columns: 1fr;
    }
  }
    .publications-contact {
      padding-block: 64px;
  }

    .publications-contact .eyebrow {
      margin: 0 0 23px;
  }

    .publications-contact h2 {
      max-width: 750px;
      margin: 0;
  }

    .publications-contact p:not(.eyebrow) {
      max-width: 650px;
      margin-block: 20px 28px;
      font-size: 1.0625rem;
      line-height: 1.75;
  }
</style>
