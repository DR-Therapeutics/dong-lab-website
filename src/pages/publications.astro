---
import home from '../content/home.json';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const asset = (path: string) => base + path.replace(/^\//, '');
const pageTitle = `Publications | ${home.labName}`;
const description = 'Selected research articles and reviews from Dong Lab at the Vancouver Prostate Centre.';
const canonical = new URL(asset('publications/'), Astro.site || Astro.url.origin).href;

// Upload the banner to public/images/publications-banner.png.
// Change this filename if you want to use another image later.
const banner = 'images/publications-banner.png';
const bannerAlt = 'Conceptual illustration of molecular structures and a pathway toward a patient and a clinician.';

// ADD NEW PUBLICATIONS HERE.
// Copy one complete object, including its final comma, to the start of this array.
// Years are grouped automatically, newest first. Within a year, your order is kept.
// Write **words to make bold** in title, authors, journal, or details.
// Always use a complete https:// address in url. Do not put ** in the URL.
const publications = [
  {
    year: 2026,
    title: 'PABPC1 dictates castration sensitivity in prostate cancer via orchestrating ferroptosis resistance and CD8(+) T-cell dysfunction',
    authors: '**Luo T**, Zhou Q, Cheng B, Fu J, Luo Y, Hu J, Zhong H, Wu Y, **Dong X**, Wu Z, Huang H, Yao K, He H, Huang H.',
    journal: 'Cell Death and Differentiation',
    details: 'Advance online publication',
    url: 'https://doi.org/10.1038/s41418-026-01870-y',
  },
  {
    year: 2026,
    title: 'Beyond Ion Channels: Emerging Roles of FGF12 in Cellular Regulation and Cancer Progression',
    authors: '**Huang Z**, **Dong X**.',
    journal: 'Cells',
    details: '15(4), 370',
    url: 'https://doi.org/10.3390/cells15040370',
  },
  {
    year: 2025,
    title: 'Noncanonical functions of UGT2B17 promote castration-resistant prostate cancer progression',
    authors: '**Feng T**, **Xie N**, **Gao L**, **Jia Q**, Kung SH, Morova T, **Li Y**, Wang L, Fazli L, Lacombe L, Guillemette C, Lévesque E, Lack NA, Qi J, Han B, **Dong X**.',
    journal: 'Journal of Clinical Investigation',
    details: '136(2), e196495',
    url: 'https://doi.org/10.1172/JCI196495',
  },
  {
    year: 2025,
    title: 'FGF12 Enhances Prostate Cancer Cell Survival via the YB1-lncRNA Axis',
    authors: '**Huang Z**, Kung SHY, Adomat H, Oo HZ, Forbes C, Hach F, **Dong X**.',
    journal: 'Cells',
    details: '14(22), 1828',
    url: 'https://doi.org/10.3390/cells14221828',
  },
  {
    year: 2025,
    title: 'Developing novel Lin28 inhibitors by computer aided drug design',
    authors: '**Matias-Barrios VM**, **Radaeva M**, **Rosellinny G**, **Jia Q**, **Xie N**, Villanueva M, Ibrahim H, Smith J, Gleave M, Lallous N, Straus SK, Cherkasov A, **Dong X**.',
    journal: 'Cell Death Discovery',
    details: '11(1), 5',
    url: 'https://doi.org/10.1038/s41420-024-02281-z',
  },
  {
    year: 2023,
    title: 'CRISPR screens reveal genetic determinants of PARP inhibitor sensitivity and resistance in prostate cancer',
    authors: 'Tsujino T, Takai T, Hinohara K, Gui F, Tsutsumi T, Bai X, Miao C, Feng C, Gui B, Sztupinszki Z, Simoneau A, **Xie N**, Fazli L, **Dong X**, Azuma H, Choudhury AD, Mouw KW, Szallasi Z, Zou L, Kibel AS, … Jia L.',
    journal: 'Nature Communications',
    details: '14(1), 252',
    url: 'https://doi.org/10.1038/s41467-023-35880-y',
  },
  {
    year: 2022,
    title: 'Discovery of Novel Lin28 Inhibitors to Suppress Cancer Cell Stemness',
    authors: '**Radaeva M**, **Ho CH**, **Xie N**, Zhang S, Lee J, Liu L, Lallous N, Cherkasov A, **Dong X**.',
    journal: 'Cancers',
    details: '14(22), 5687',
    url: 'https://doi.org/10.3390/cancers14225687',
  },
  {
    year: 2021,
    title: 'Optimization of New Catalytic Topoisomerase II Inhibitors as an Anti-Cancer Therapy',
    authors: '**Matias-Barrios VM**, **Radaeva M**, **Ho CH**, Lee J, Adomat H, Lallous N, Cherkasov A, **Dong X**.',
    journal: 'Cancers',
    details: '13(15), 3675',
    url: 'https://doi.org/10.3390/cancers13153675',
  },
  {
    year: 2020,
    title: 'LIN28B promotes the development of neuroendocrine prostate cancer',
    authors: '**Lovnicki J**, **Gan Y**, **Feng T**, **Li Y**, **Xie N**, **Ho CH**, **Lee AR**, Chen X, Nappi L, Han B, Fazli L, Huang J, Gleave ME, **Dong X**.',
    journal: 'Journal of Clinical Investigation',
    details: '130(10), 5338–5348',
    url: 'https://doi.org/10.1172/JCI135373',
  },
];

// Everything below this point renders the list; adding a paper needs no HTML edits.
const years = [...new Set(publications.map((paper) => paper.year))].sort((a, b) => b - a);

// Only **bold** is supported. Normal text is escaped by Astro, not inserted as HTML.
const boldParts = (text: string) => text.split(/(\*\*[^*]+\*\*)/g).map((part) => {
  const bold = part.startsWith('**') && part.endsWith('**') && part.length > 4;
  return { bold, text: bold ? part.slice(2, -2) : part };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08253f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset(banner), Astro.site || Astro.url.origin).href} />
    <meta property="og:image:alt" content={bannerAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPage="publications" />

    <main id="main">
      <section class="hero publications-hero" id="top" aria-labelledby="publications-title">
        <img
          class="hero-image"
          src={asset(banner)}
          alt={bannerAlt}
          width="1672"
          height="941"
          fetchpriority="high"
        />
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">RESEARCH FROM THE DONG LAB</p>
            <h1 id="publications-title">Our publications.<em>Sharing discovery.</em></h1>
            <p class="hero-description">Explore our work in RNA biology, cancer research, and therapeutic discovery.</p>
            <div class="hero-actions">
              <a class="button button-light" href="#publications">Browse publications <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <p class="hero-caption">Conceptual research illustration</p>
        </div>
      </section>

      <div class="affiliation-strip">
        <div class="container affiliation-inner">
          <a href="https://www.prostatecentre.com/">Vancouver Prostate Centre</a>
          <span class="strip-divider" aria-hidden="true"></span>
          <a href="https://urology.med.ubc.ca/">UBC · Department of Urologic Sciences</a>
        </div>
      </div>

      <section class="section publications-section" id="publications" aria-labelledby="selected-title">
        <div class="container">
          <div class="section-intro publications-intro">
            <div>
              <p class="eyebrow">OUR PUBLISHED WORK</p>
              <h2 id="selected-title">Selected publications.</h2>
            </div>
            <p>A selection of research articles and reviews from the Dong Lab.</p>
          </div>

          {years.map((year) => (
            <section class="publication-year" aria-labelledby={`year-${year}`}>
              <h3 class="publication-year-label" id={`year-${year}`}>{year}</h3>
              <ul class="publication-list">
                {publications.filter((paper) => paper.year === year).map((paper) => (
                  <li>
                    <article class="publication-entry">
                      <h4 class="publication-title">
                        <a href={paper.url}>
                          {boldParts(paper.title).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}
                        </a>
                      </h4>
                      <p class="publication-authors">
                        {boldParts(paper.authors).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}
                      </p>
                      <p class="publication-citation">
                        <em>{boldParts(paper.journal).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}</em>
                        {' · '}{paper.year}{' · '}
                        {boldParts(paper.details).map((part) => part.bold ? <strong>{part.text}</strong> : part.text)}
                      </p>
                      <a class="inline-link publication-read" href={paper.url} aria-label={`Read ${paper.title.replaceAll('**', '')}`}>
                        Read publication <span aria-hidden="true">↗</span>
                      </a>
                    </article>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          {publications.length === 0 && <p>Our publication list will be available soon.</p>}
        </div>
      </section>

      <section class="contact-section publications-contact" aria-labelledby="publication-contact-title">
        <div class="container">
          <p class="eyebrow">CONNECT WITH US</p>
          <h2 id="publication-contact-title">Continue the conversation.</h2>
          <p>Interested in our work or a possible collaboration? We would like to hear from you.</p>
          <a class="button button-light" href={`${base}#contact`}>Contact the lab <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getUTCFullYear()} {home.labName}</p>
        <p>RNA biology. Cancer research. Therapeutic discovery.</p>
        <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "aa79c36c6ed04e05b5b7e1e19f3b9453"}'></script>
  </body>
</html>

<style>
  .publications-hero { height: auto; min-height: 0; }
  .publications-hero .hero-inner { min-height: 460px; padding-block: clamp(64px, 7vw, 96px); }
  .publications-hero .hero-copy { max-width: 760px; }
  .publications-hero .hero-image { object-position: center; }
  .publications-hero .hero-shade { background: linear-gradient(90deg, rgba(4, 22, 43, 0.83), rgba(4, 22, 43, 0.35) 62%, rgba(4, 22, 43, 0.08)); }
  .publications-section { scroll-margin-top: 110px; }
  .publications-intro { margin-bottom: 48px; }
  .publication-year { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 48px; border-top: 1px solid rgba(8, 37, 63, 0.18); }
  .publication-year-label { margin: 0; padding-top: 34px; color: #08253f; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 500; line-height: 1.2; }
  .publication-list { list-style: none; margin: 0; padding: 0; }
  .publication-list > li { margin: 0; padding: 0; }
  .publication-list > li + li { border-top: 1px solid rgba(8, 37, 63, 0.12); }
  .publication-entry { padding-block: 34px 38px; }
  .publication-title { margin: 0 0 16px; font-size: clamp(1.25rem, 2.1vw, 1.65rem); font-weight: 500; line-height: 1.45; }
  .publication-title a { color: #08253f; text-decoration: none; }
  .publication-title a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .publication-authors { margin: 0 0 12px; color: #334b5f; font-size: 1rem; line-height: 1.8; }
  .publication-citation { margin: 0 0 20px; color: #496276; font-size: 0.95rem; line-height: 1.7; }
  .publication-entry strong { font-weight: 700; color: #08253f; }
  .publication-read { display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; }
  .publication-entry a:focus-visible { outline: 2px solid #397d9e; outline-offset: 5px; }
  .publications-contact { padding-block: 64px; }
  .publications-contact h2 { max-width: 750px; }
  .publications-contact p:not(.eyebrow) { max-width: 650px; margin-block: 20px 28px; }

  @media (max-width: 760px) {
    .publication-year { grid-template-columns: 1fr; gap: 0; }
    .publication-year-label { padding-top: 28px; }
    .publication-entry { padding-block: 24px 30px; }
    .publications-intro { margin-bottom: 32px; }
    .publications-section { scroll-margin-top: 90px; }
  }

  @media (max-width: 600px) {
    .publications-hero .hero-inner { min-height: 440px; padding-block: 64px; }
    .publications-hero .hero-image { object-position: 66% center; }
    .publications-hero .hero-shade { background: rgba(4, 22, 43, 0.64); }
  }
</style>
