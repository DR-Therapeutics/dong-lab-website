---
import home from '../content/home.json';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import HeroBackground from '../components/HeroBackground.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const asset = (path: string) => base + path.replace(/^\//, '');
const canonical = new URL(base, Astro.site || Astro.url.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={home.description} />
    <meta name="theme-color" content="#08253f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={home.pageTitle} />
    <meta property="og:description" content={home.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset(home.hero.image), Astro.site || Astro.url.origin).href} />
    <meta property="og:image:alt" content={home.hero.imageAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>{home.pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPage="home" />
    <main id="main">
      <section class="hero" id="home" aria-labelledby="hero-title">
        <HeroBackground
  imageSrc={home.hero.image}
  imageAlt={home.hero.imageAlt}
/>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">{home.hero.eyebrow}</p>
            <h1 id="hero-title">{home.hero.title}<em>{home.hero.accent}</em></h1>
            <p class="hero-description">{home.hero.text}</p>
            <div class="hero-actions">
              <a class="button button-light" href="#research">Explore our research <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <p class="hero-caption">Conceptual research illustration</p>
        </div>
      </section>
      <div class="affiliation-strip">
        <div class="container affiliation-inner">
          <a href="https://www.prostatecentre.com/">Vancouver Prostate Centre</a>
          <span class="strip-divider" aria-hidden="true"></span>
          <a href="https://urology.med.ubc.ca/">UBC · Department of Urologic Sciences</a>
        </div>
      </div>
      <section class="section about-section" id="about" aria-labelledby="about-title">
        <div class="container about-grid">
          <div>
            <p class="eyebrow">{home.about.label}</p>
            <h2 id="about-title">{home.about.title}</h2>
          </div>
          <div class="about-copy">
            <p>{home.about.text}</p>
            <a class="inline-link" href="https://dong-lab.ca/#contact">Meet Dr. Xuesen Dong <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="section research-section" id="research" aria-labelledby="research-title">
        <div class="container">
          <div class="section-intro">
            <div>
              <p class="eyebrow">{home.research.label}</p>
              <h2 id="research-title">{home.research.title}</h2>
            </div>
            <p>{home.research.intro}</p>
          </div>
          <div class="research-grid">
            {home.research.areas.map(area => (
              <article class="research-area">
                <span class="research-number" aria-hidden="true">{area.number}</span>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
                <p class="research-detail">{area.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section class="section approach-section" aria-labelledby="approach-title">
        <div class="container approach-grid">
          <figure class="approach-image">
            <img src={asset(home.approach.image)} alt={home.approach.imageAlt} width="1671" height="941" loading="lazy" decoding="async" />
            <figcaption>Conceptual research illustration</figcaption>
          </figure>
          <div class="approach-copy">
            <p class="eyebrow">{home.approach.label}</p>
            <h2 id="approach-title">{home.approach.title}</h2>
            <p>{home.approach.text}</p>
            <ol class="approach-steps">
              {home.approach.steps.map((step, index) => <li><span aria-hidden="true">0{index + 1}</span>{step}</li>)}
            </ol>
          </div>
        </div>
      </section>
      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="container contact-grid">
          <div>
            <p class="eyebrow">{home.contact.label}</p>
            <h2 id="contact-title">{home.contact.title}</h2>
            <p class="contact-description">{home.contact.text}</p>
            <a class="button button-light" href={`mailto:${home.contact.email}`}>Email the lab <span aria-hidden="true">↗</span></a>
          </div>
          <address class="contact-details">
            <strong>{home.contact.name}</strong>
            <p>{home.contact.role}</p>
            <a href={`mailto:${home.contact.email}`}>{home.contact.email}</a>
            <p>{home.contact.location}</p>
            <a class="profile-link" href={home.contact.profileUrl}>View institutional profile <span aria-hidden="true">↗</span></a>
          </address>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getUTCFullYear()} {home.labName}</p>
        <p>RNA biology. Cancer research. Therapeutic discovery.</p>
        <a href="#home">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "aa79c36c6ed04e05b5b7e1e19f3b9453"}'></script><!-- End Cloudflare Web Analytics -->

</body>
</html>
