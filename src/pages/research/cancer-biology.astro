---
import ResearchLayout from '../../layouts/ResearchLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const asset = (path: string) => base + path.replace(/^\//, '');

// Upload the original figures to public/images/research/.
// Filenames are case-sensitive: UGT_AR.jpg and SRRM4_splicing.jpg.

const publications = [
  {
    title: 'Noncanonical functions of UGT2B17 promote castration-resistant prostate cancer progression',
    authors: 'Feng T. et al.',
    journal: 'The Journal of clinical investigation',
    year: '2025',
    url: 'https://doi.org/10.1172/JCI196495',
  },
  {
    title: 'SRRM4 Drives Neuroendocrine Transdifferentiation of Prostate Adenocarcinoma Under Androgen Receptor Pathway Inhibition',
    authors: 'Li Y. et al.',
    journal: 'European Urology',
    year: '2017',
    url: 'https://doi.org/10.1016/j.eururo.2016.04.028',
  },
  {
    title: 'LIN28B promotes the development of neuroendocrine prostate cancer',
    authors: 'Lovnicki J. et al.',
    journal: 'Journal of Clinical Investigation',
    year: '2020',
    url: 'https://doi.org/10.1172/JCI135373',
  },
];
---

<ResearchLayout
  slug="cancer-biology"
  bannerImage="images/research/cancer-biology-banner.webp"
  bannerImageAlt="Conceptual illustration of a blue tumour spheroid with coral highlights."
  number="01"
  topic="Cancer biology & treatment resistance"
  title="Cancer biology."
  accent="Understanding resistance."
  description="We investigate how androgen receptor signalling and RNA regulation help prostate cancer cells survive treatment, change their identity and continue to grow."
  question="How do cancer cells adapt when the pathways they depend on are blocked?"
  keywords={['Androgen receptor', 'RNA splicing', 'Cell-state changes']}
  sections={[
    { id: 'overview', label: 'Overview' },
    { id: 'research-focus', label: 'What we study' },
    { id: 'how-we-work', label: 'How we study it' },
    { id: 'questions', label: 'Questions that guide us' },
  ]}
  publications={publications}
>
  <!-- Edit the text below to update this page. Use <strong>text</strong> for bold. -->
  <section class="rd-section" id="overview" aria-labelledby="overview-heading">
    <p class="eyebrow">THE BIOLOGICAL CHALLENGE</p>
    <h2 id="overview-heading">Understanding how resistant disease develops.</h2>
    <p>
      Prostate cancer often depends on signals from the <strong>androgen receptor (AR)</strong>.
      Treatments that reduce androgen levels or block this receptor can control disease,
      but some tumours find ways to keep growing. Prostate cancer that progresses despite
      androgen deprivation is called <strong>castration-resistant prostate cancer (CRPC)</strong>.
    </p>
    <p>
      Our research examines two connected routes to resistance: maintaining AR activity
      under treatment, and adopting cell states that rely less on AR signalling. We focus
      on transcription, RNA splicing and RNA-binding proteins to understand how these
      changes happen and where they create opportunities for intervention.
    </p>
  </section>

  <section class="rd-section" id="research-focus" aria-labelledby="focus-heading">
    <p class="eyebrow">WHAT WE STUDY</p>
    <h2 id="focus-heading">From RNA regulation to tumour behaviour.</h2>
    <div class="rd-focus-list">
      <article class="rd-focus">
        <span class="rd-focus-number" aria-hidden="true">01</span>
        <div>
          <h3>Androgen receptor signalling and AR-V7</h3>
          <p>
            Alternative RNA splicing allows a gene to produce different RNA messages.
            Our work has helped explain how this process generates <strong>AR-V7</strong>,
            an AR variant associated with resistant disease. We also investigate proteins
            and regulatory pathways that support AR activity when androgen signalling
            is disrupted, including mechanisms involving UGT2B17, BMI1, PARP2, KIF15 and RUVBL1.
          </p>

          <figure class="rd-research-figure">
            <a
              class="rd-figure-image"
              href={asset('images/research/UGT_AR.jpg')}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open the UGT2B17 and AR signalling figure at full size (opens in a new tab)"
            >
              <img
                src={asset('images/research/UGT_AR.jpg')}
                alt="Diagram comparing androgen-dependent AR signalling with UGT2B17 and c-Src-associated AR signalling in castration-resistant prostate cancer."
                width="2048"
                height="865"
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption>
              <span><strong>UGT2B17 and AR signalling.</strong> A model of changes in AR signalling in castration-resistant prostate cancer.</span>
              <a
                class="rd-figure-link"
                href={asset('images/research/UGT_AR.jpg')}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View the UGT2B17 and AR signalling figure at full size (opens in a new tab)"
              >View full-size figure <span aria-hidden="true">↗</span></a>
            </figcaption>
          </figure>
        </div>
      </article>
      <article class="rd-focus">
        <span class="rd-focus-number" aria-hidden="true">02</span>
        <div>
          <h3>RNA splicing and neuroendocrine disease</h3>
          <p>
            Some resistant tumours acquire neuroendocrine features and become less
            dependent on AR. Our studies identified a splicing programme associated
            with <strong>neuroendocrine prostate cancer (NEPC)</strong> and a central role
            for the splicing factor <strong>SRRM4</strong>. We investigate how its effects
            on regulators such as REST alter cell identity and tumour behaviour.
          </p>

          <figure class="rd-research-figure">
            <a
              class="rd-figure-image"
              href={asset('images/research/SRRM4_splicing.jpg')}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open the SRRM4 and RNA splicing figure at full size (opens in a new tab)"
            >
              <img
                src={asset('images/research/SRRM4_splicing.jpg')}
                alt="Diagram linking chromatin organization and SRRM4-associated RNA splicing with cell survival, lineage plasticity, proliferation and neuroendocrine differentiation."
                width="1800"
                height="1588"
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption>
              <span><strong>SRRM4 and RNA splicing.</strong> An overview of RNA regulation, cell-state changes and neuroendocrine differentiation.</span>
              <a
                class="rd-figure-link"
                href={asset('images/research/SRRM4_splicing.jpg')}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View the SRRM4 and RNA splicing figure at full size (opens in a new tab)"
              >View full-size figure <span aria-hidden="true">↗</span></a>
            </figcaption>
          </figure>
        </div>
      </article>
      <article class="rd-focus">
        <span class="rd-focus-number" aria-hidden="true">03</span>
        <div>
          <h3>Stem-like programmes and cellular plasticity</h3>
          <p>
            Cellular plasticity is the ability of cells to change their state. Our
            research linked <strong>LIN28B</strong> to a stem-like gene programme involving
            let-7 and <strong>SOX2</strong> in NEPC models. This work connects RNA regulation
            with the flexibility that can allow cancer cells to adapt to treatment.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="rd-section" id="how-we-work" aria-labelledby="methods-heading">
    <p class="eyebrow">OUR APPROACH</p>
    <h2 id="methods-heading">Connecting molecular mechanisms with disease.</h2>
    <dl class="rd-methods">
      <div>
        <dt>Identify changes in gene expression and RNA processing</dt>
        <dd>Transcriptomic analysis and bioinformatics help identify the RNA programmes associated with different tumour states.</dd>
      </div>
      <div>
        <dt>Test how individual regulators work</dt>
        <dd>Molecular and cellular experiments investigate how changing a protein or pathway affects RNA regulation, cell identity and growth.</dd>
      </div>
      <div>
        <dt>Connect experimental findings with tumour biology</dt>
        <dd>Disease models and analyses of tumour specimens help us examine the relevance of these mechanisms to resistant prostate cancer.</dd>
      </div>
    </dl>
  </section>

  <section class="rd-section" id="questions" aria-labelledby="questions-heading">
    <p class="eyebrow">LOOKING AHEAD</p>
    <h2 id="questions-heading">Questions that guide our research.</h2>
    <ul class="rd-questions">
      <li>Which RNA-processing changes allow AR signalling to persist during treatment?</li>
      <li>What enables tumour cells to switch into neuroendocrine or stem-like states?</li>
      <li>Which molecular dependencies could become targets for new therapeutic strategies?</li>
    </ul>
  </section>
</ResearchLayout>

<style>
  /* Figure styles apply only to this page. Images keep their original proportions. */
  .rd-research-figure {
    width: 100%;
    min-width: 0;
    margin: 26px 0 6px;
  }

  .rd-figure-image {
    display: block;
    padding: clamp(8px, 1.5vw, 16px);
    border: 1px solid #d7e0e5;
    border-radius: 4px;
    background: #fff;
    text-decoration: none;
    cursor: zoom-in;
  }

  .rd-figure-image img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .rd-research-figure figcaption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 14px;
    color: #60727d;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .rd-research-figure figcaption strong {
    color: #102e44;
    font-weight: 700;
  }

  .rd-figure-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-block: 8px;
    color: #08253f;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .rd-research-figure a:focus-visible {
    outline: 3px solid #397d9e;
    outline-offset: 4px;
  }
</style>